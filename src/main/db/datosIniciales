INSERT INTO `item` (`name`, `description`, `picture`, `category_id`) VALUES
('Esferas del dragon','Las Esferas del Dragón son siete misteriosas esferas mágicas de color naranja. Tienen estrellas rojas grabadas en su interior, desde una hasta siete estrellas. Fueron creadas por el pueblo namekiano y tienen el poder de invocar al dragón sagrado Shen Long para conceder deseos.','https://static.wikia.nocookie.net/dragonball/images/8/8e/Esferas_del_Drag%C3%B3n_Blue_Velvet.png/revision/latest?cb=20230214174437&path-prefix=es',1)
,('Espadas del Caos','Las Espadas del Caos son un par de hojas curvas de acero oscuro unidas a largas cadenas que se funden con los antebrazos del guerrero espartano Kratos.','https://www.aceros-de-hispania.com/53650-large_default/espadas-del-caos-god-of-war.jpg',2)
,('DeLorean DMC-12','El DeLorean DMC-12 es una máquina del tiempo construida por el doctor Emmett Brown. Está modificado con un condensador de flujo, un reactor de plutonio y el sistema de desplazamiento temporal.','https://acnews.blob.core.windows.net/imgnews/medium/NAZ_bf7e3903a04e46daa9d927049d764d97.webp',3)
,('Radar del Dragón', 'El Radar del Dragón es un dispositivo de rastreo portátil creado por la científica Bulma de la corporación Capsula. Posee una pantalla verde cuadriculada capaz de detectar la radiación electromagnética única que emiten las Esferas del Dragón, mostrando su ubicación exacta mediante puntos amarillos parpadeantes.', 'https://static.wikia.nocookie.net/dragonball/images/7/78/Dragon_Radar.png/revision/latest?cb=20130311014539&path-prefix=es', 1)
,('Death Note', 'Un cuaderno sobrenatural de cubierta negra perteneciente a un Shinigami. Tiene la capacidad de causar la muerte de cualquier ser humano cuyo nombre sea escrito en sus páginas, siempre que el portador visualice el rostro de la víctima en su mente.', 'https://unsplash.com', 1)
,('Ocarina del Tiempo', 'Un antiguo instrumento musical de viento hecho de cerámica azul con el emblema de la Trifuerza grabado. Permite a su portador manipular el flujo del tiempo, abrir portales mágicos y alterar el clima mediante la interpretación de melodías sagradas.', 'https://unsplash.com', 2)
,('Espada Maestra', 'La legendaria Espada Destructora del Mal. Forjada por la diosa Hylia, posee una hoja de doble filo reluciente, una empuñadura púrpura con alas y la capacidad única de repeler la magia oscura y romper maldiciones ancestrales.', 'https://unsplash.com', 2)
,('Sable de Luz de Luke Skywalker', 'Un arma elegante para una era más civilizada. Este sable de luz emite una hoja de plasma verde puro concentrada a través de un cristal Kyber. Fue construido manualmente por el caballero Jedi Luke Skywalker tras perder su primera arma en Bespin.', 'https://unsplash.com', 3)
,('Anillo Único', 'Un anillo de oro liso forjado por el Señor Oscuro Sauron en los fuegos del Monte del Destino. Concede invisibilidad a los mortales que lo portan, corrompe la mente de quien lo posee y busca constantemente regresar a las manos de su creador.', 'https://unsplash.com', 3)
,('Cristal Kyber', 'Un cristal raro, resonante con la Fuerza, que crece de manera natural en varios planetas. Son el corazón de los sables de luz, capaces de canalizar la energía de plasma concentrada que da forma a la hoja cromática.', 'https://unsplash.com', 3);


CREATE TABLE `event` (
  `id` int(10) unsigned NOT NULL AUTO_INCREMENT,
  `title` varchar(255) NOT NULL,
  `description` varchar(500) NOT NULL,
  `endTime` time NOT NULL,
  `startTime` time NOT NULL,
  `status` varchar(20) NOT NULL,
  PRIMARY KEY (`id`)
