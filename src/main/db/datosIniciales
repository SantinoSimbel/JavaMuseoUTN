INSERT INTO `item` (`name`, `description`, `picture`, `category_id`) VALUES
('Esferas del dragon','Siete misteriosas esferas mágicas de color naranja. Tienen estrellas rojas grabadas en su interior, desde una hasta siete estrellas. Fueron creadas por el pueblo namekiano y tienen el poder de invocar al dragón sagrado Shen Long para conceder deseos.','https://static.wikia.nocookie.net/dragonball/images/8/8e/Esferas_del_Drag%C3%B3n_Blue_Velvet.png/revision/latest?cb=20230214174437&path-prefix=es',1)
,('Digivice de Tai', 'Un pequeño dispositivo electrónico de color naranja perteneciente a Tai Kamiya. Permite canalizar la energía del valor para desencadenar la digievolución de Agumon y rastrear la presencia de otros Niños Elegidos.', 'https://static.wikia.nocookie.net/digimon/images/0/01/DigiviceTaichi.png/revision/latest?cb=20151219213358&path-prefix=es', 1)
,('Espadas del Caos','Un par de hojas curvas de acero oscuro unidas a largas cadenas que se funden con los antebrazos del guerrero espartano Kratos.','https://www.aceros-de-hispania.com/53650-large_default/espadas-del-caos-god-of-war.jpg',2)
,('Grub Encerrado', 'Una pequeña y simpática larva nativa de Hallownest atrapada dentro de un frasco de vidrio reinforced. Emite un característico gemido de auxilio esperando ser liberado para regresar con el Padre Grub.', 'https://i.etsystatic.com/16747504/r/il/85417b/2483775562/il_fullxfull.2483775562_6cu2.jpg', 2)
,('DeLorean DMC-12','Una máquina del tiempo construida por el doctor Emmett Brown. Está modificado con un condensador de flujo, un reactor de plutonio y el sistema de desplazamiento temporal.','https://acnews.blob.core.windows.net/imgnews/medium/NAZ_bf7e3903a04e46daa9d927049d764d97.webp',3)
,('Tengen Toppa Gurren Lagann', 'Un mecha de proporciones colosales formado por la energía espiral de la Brigada Dai-Gurren. Representa el ápice de la evolución y la determinación de la humanidad.', 'https://www.sideshow.com/cdn-cgi/image/quality=90,f=auto/https://www.sideshow.com/storage/product-images/914429/ccs-toys-tengen-toppa-gurren-lagann-tengen-toppa-gurren-lagann-alloy-action-figure-gallery-68003f1fe790d.jpg', 1)
,('Radar del Dragón', 'Un dispositivo de rastreo portátil creado por la científica Bulma de la corporación Capsula. Posee una pantalla verde cuadriculada capaz de detectar la radiación electromagnética única que emiten las Esferas del Dragón, mostrando su ubicación exacta mediante puntos amarillos parpadeantes.', 'https://static.wikia.nocookie.net/fortnite/images/d/d9/Cosm%C3%A9tico_Radar_del_drag%C3%B3n.png/revision/latest?cb=20260105234743&path-prefix=es', 1)
,('Wilson', 'Una pelota de voleibol de la marca Wilson marcada con la huella de una mano ensangrentada que simula un rostro humano. Creada por Chuck Noland durante su aislamiento en una isla desierta para conservar la cordura.', 'https://media.ambito.com/p/d89181359a0a05c1aadd27c072e51c37/adjuntos/239/imagenes/038/735/0038735889/wilson-naufrago.jpg', 3)
,('Death Note', 'Un cuaderno sobrenatural de cubierta negra perteneciente a un Shinigami. Tiene la capacidad de causar la muerte de cualquier ser humano cuyo nombre sea escrito en sus páginas, siempre que el portador visualice el rostro de la víctima en su mente.', 'https://m.media-amazon.com/images/I/61QBWmBSS+L._AC_SX679_.jpg', 1)
,('Ocarina del Tiempo', 'Un antiguo instrumento musical de viento hecho de cerámica azul con el emblema de la Trifuerza grabado. Permite a su portador manipular el flujo del tiempo, abrir portales mágicos y alterar el clima mediante la interpretación de melodías sagradas.', 'https://static.wikia.nocookie.net/zelda_gamepedia_en/images/9/97/OoT_Ocarina_of_Time_Render.png/revision/latest?cb=20110801131627', 2)
,('Espada Maestra', 'La legendaria Espada Destructora del Mal. Forjada por la diosa Hylia, posee una hoja de doble filo reluciente, una empuñadura púrpura con alas y la capacidad única de repeler la magia oscura y romper maldiciones ancestrales.', 'https://i.redd.it/k33r8lft9r651.jpg', 2)
,('Game Boy con Tetris espacial', 'La consola portátil Game Boy original que viajó a la estación espacial MIR en 1993 junto al cosmonauta Aleksandr Serebrov. Acompañada del cartucho de Tetris, se convirtió oficialmente en el primer videojuego jugado en el espacio exterior.', 'https://upload.wikimedia.org/wikipedia/commons/9/9d/Tetris_on_Game_Boy.jpg?utm_source=es.wikipedia.org&utm_campaign=index&utm_content=original', 2)
,('Sable de Luz de Luke Skywalker', 'Un arma elegante para una era más civilizada. Este sable de luz emite una hoja de plasma verde puro concentrada a través de un cristal Kyber. Fue construido manualmente por el caballero Jedi Luke Skywalker tras perder su primera arma en Bespin.', 'https://media.makeameme.org/created/best-placeholder-ever.jpg', 3)
,('Cristal Kyber', 'Un cristal raro, resonante con la Fuerza, que crece de manera natural en varios planetas. Son el corazón de los sables de luz, capaces de canalizar la energía de plasma concentrada que da forma a la hoja cromática.', 'https://media.makeameme.org/created/best-placeholder-ever.jpg', 3);


